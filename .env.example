APP_NAME="V2Ray Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# پورتی که پنل روی هاست باز می‌شود
APP_PORT=8080
# آدرس bind پنل. اگر روی همین سرور ریورس‌پروکسی دیگری (nginx/Caddy) دارید،
# این را 127.0.0.1 بگذارید تا پورت از بیرون باز نشود و تداخل پیش نیاید.
APP_BIND=0.0.0.0

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vpnpanel
DB_USERNAME=vpnpanel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=redis
SESSION_LIFETIME=240
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------- تنظیمات پنل ----------
# دامنه‌ای که لینک اشتراک (subscription) با آن ساخته می‌شود
PANEL_SUB_DOMAIN="${APP_URL}"
# پیشوند نمایشی روی کانفیگ‌ها
PANEL_BRAND="MyVPN"
# واحد پول
PANEL_CURRENCY=IRT
# چند روز قبل از انقضا هشدار داده شود
PANEL_EXPIRY_WARNING_DAYS=3
# مسیر باینری xray داخل کانتینر app (نقش کلاینت API)
PANEL_XRAY_BIN=/usr/local/bin/xray
# آدرس API سرویس xray روی شبکهٔ داخلی داکر
PANEL_XRAY_API=xray:10085

# ---------- نود VPN محلی ----------
# پورتی که Xray روی همین سرور برای مشتری‌ها باز می‌کند.
# با `php artisan panel:setup-local-node --port=...` تنظیم می‌شود.
# اگر سرویس دیگری (مثلاً Caddy) پورت 443 را گرفته، پورت دیگری انتخاب کنید.
XRAY_PORT=443
